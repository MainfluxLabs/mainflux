{{ define "content" }}
    {{ $showTime := and .Fields (index .Fields 0).Time }}

    <p class="mb-16">
        A message from the thing with ID <strong>
            {{- if .ThingURL -}}
            <a href="{{ .ThingURL }}">{{ .ThingID }}</a>
            {{- else -}}
            {{ .ThingID }}
            {{- end -}}
        </strong> matched a rule.
    </p>

    <table class="details">
        {{ if .Subtopic }}
        <tr>
            <th class="details__label">Subtopic</th>
            <td class="details__value">{{ .Subtopic }}</td>
        </tr>
        {{ end }}
        <tr>
            <th class="details__label">Protocol</th>
            <td class="details__value">{{ .Protocol }}</td>
        </tr>
        {{ if not $showTime }}
        <tr>
            <th class="details__label">Time</th>
            <td class="details__value">{{ .Time }}</td>
        </tr>
        {{ end }}
        {{ if .RuleID }}
        <tr>
            <th class="details__label">Rule ID</th>
            <td class="details__value">
                {{ if .RuleURL }}
                <a href="{{ .RuleURL }}">{{ .RuleID }}</a>
                {{ else }}
                {{ .RuleID }}
                {{ end }}
            </td>
        </tr>
        {{ end }}
    </table>

    {{ if .Conditions }}
    <p class="section-title">Triggered by</p>
    <pre class="code-block">{{ .Conditions }}</pre>
    {{ end }}

    <p class="section-title">Values</p>

    {{ if .Fields }}
    <table class="details">
        <tr>
            <th class="details__header">Name</th>
            <th class="details__header">Value</th>
            {{ if $showTime }}
            <th class="details__header">Time</th>
            {{ end }}
        </tr>
        {{ range .Fields }}
        <tr>
            <td class="details__value">{{ .Name }}</td>
            <td class="details__value">{{ .Value }}</td>
            {{ if $showTime }}
            <td class="details__value">{{ .Time }}</td>
            {{ end }}
        </tr>
        {{ end }}
    </table>
    {{ else }}
    <pre class="code-block">{{ .MessageContent }}</pre>
    {{ end }}
{{ end }}
